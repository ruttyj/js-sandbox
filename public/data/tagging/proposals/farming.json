          "Farming",
          "Seeds",
          "Saplings",
          "Farming tools"
        ],
        "nameRegex": "^(Elkhorn|Pillar|Umbral) coral$",
        "excludeNameRegex": "^(Mithril seeds|Adamant seeds|Grand seed pod)$| yarn$"
      }
    },
