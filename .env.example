# Copy to .env and fill in. These defaults are for local development on http://localhost:3000.
# .env is read by `npm run dev` and by docker compose; it is git-ignored, so secrets stay local.

# development | production. Production requires a real SESSION_SECRET and disables DEV_LOGIN.
NODE_ENV=development
PORT=3000

# The address people open the app at, without a trailing slash. Google sends users back to
# ${BASE_URL}/auth/google/callback, so that exact URL must be listed in the OAuth client's
# "Authorized redirect URIs". An https:// address also makes the session cookie https-only.
BASE_URL=http://localhost:3000

# Signs the session cookie. Use a long random string in production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string-for-production

# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID,
# type "Web application"). Leave empty to turn Google sign-in off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Adds a "Sign in as dev user" button so the app can be used without Google. Ignored in production.
DEV_LOGIN=true

# Where the SQLite database and cached item icons are kept. Relative to the project root.
# The Docker image sets this to /data (a volume).
DATA_DIR=storage

# --- docker-compose.prod.yml (Traefik) only ---------------------------------------------------
# The domain Traefik serves the app on, and the email Let's Encrypt sends certificate notices to.
DOMAIN=ge-tracker.example.com
ACME_EMAIL=you@example.com
